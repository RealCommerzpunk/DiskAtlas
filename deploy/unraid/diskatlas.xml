<?xml version="1.0"?>
<!-- Unraid-Vorlage für DiskAtlas. Installation: siehe docs/UNRAID.md -->
<Container version="2">
  <Name>DiskAtlas</Name>
  <Repository>ghcr.io/realcommerzpunk/diskatlas:latest</Repository>
  <Registry>https://github.com/RealCommerzpunk/DiskAtlas/pkgs/container/diskatlas</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/RealCommerzpunk/DiskAtlas/issues</Support>
  <Project>https://github.com/RealCommerzpunk/DiskAtlas</Project>
  <Icon>https://raw.githubusercontent.com/RealCommerzpunk/DiskAtlas/main/src/diskatlas/web/static/icon_256.png</Icon>
  <Overview>Festplatteninventar: Weboberfläche, API und Datenbank. Die Festplatten meldet das Agent-Programm auf deinen Rechnern (Windows/Linux, siehe Releases). Mit installierbarer Web-App fürs iPhone.</Overview>
  <Category>Tools: Status:Stable</Category>
  <WebUI>http://[IP]:[PORT:8765]/</WebUI>
  <ExtraParams>--health-start-period=20s</ExtraParams>
  <Config Name="Web-Port" Target="8765" Default="8765" Mode="tcp" Description="Port der Weboberfläche und API" Type="Port" Display="always" Required="true" Mask="false">8765</Config>
  <Config Name="Daten" Target="/data" Default="/mnt/user/appdata/diskatlas" Mode="rw" Description="Datenbank (SQLite)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/diskatlas</Config>
  <Config Name="Passwort" Target="DISKATLAS_PASSWORD" Default="" Mode="" Description="Startpasswort des Benutzers Master (Pflicht, wird nur beim ersten Start übernommen; Anmeldename: Master)" Type="Variable" Display="always" Required="true" Mask="true"/>
</Container>
